// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────

enum CollegeType {
  PUBLIC
  PRIVATE
  DEEMED
}

enum DegreeType {
  BACHELORS
  MASTERS
  PHD
  DIPLOMA
}

enum ExamCategory {
  ENGINEERING
  MANAGEMENT
  MEDICAL
  LAW
  DESIGN
  OTHER
}

// ─── Models ──────────────────────────────────────────────────────────

model College {
  id              String      @id @default(cuid())
  name            String      @unique
  slug            String      @unique
  description     String      @db.Text
  establishedYear Int
  type            CollegeType
  accreditation   String?
  logoUrl         String?
  coverImageUrl   String?
  website         String?
  city            String
  state           String
  country         String      @default("India")
  latitude        Float?
  longitude       Float?
  rating          Float       @default(0)
  totalStudents   Int?
  acceptanceRate  Float?

  courses  Course[]
  placements Placement[]
  reviews  Review[]
  cutoffs  CollegeExamCutoff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([city])
  @@index([state])
  @@index([type])
  @@index([rating])
}

model Course {
  id             String     @id @default(cuid())
  collegeId      String
  name           String
  duration       String     // e.g., "4 years"
  degreeType     DegreeType
  fees           Float
  seatsAvailable Int?
  eligibility    String?    @db.Text

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  cutoffs CollegeExamCutoff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId])
  @@index([degreeType])
}

model Placement {
  id              String   @id @default(cuid())
  collegeId       String
  year            Int
  averagePackage  Float
  medianPackage   Float?
  highestPackage  Float
  lowestPackage   Float?
  placementRate   Float    // percentage 0-100
  topRecruiters   String[] // array of company names

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, year])
  @@index([collegeId])
}

model Review {
  id             String  @id @default(cuid())
  collegeId      String
  authorName     String
  rating         Float   // 1.0 - 5.0
  title          String
  content        String  @db.Text
  pros           String? @db.Text
  cons           String? @db.Text
  graduationYear Int?
  courseName     String?
  isVerified     Boolean @default(false)

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId])
  @@index([rating])
}

model Exam {
  id       String       @id @default(cuid())
  name     String       @unique // e.g., "JEE Main"
  fullName String
  category ExamCategory

  cutoffs CollegeExamCutoff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CollegeExamCutoff {
  id               String @id @default(cuid())
  collegeId        String
  examId           String
  courseId          String
  year             Int
  generalCutoffRank Int
  obcCutoffRank    Int?
  scCutoffRank     Int?
  stCutoffRank     Int?

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, examId, courseId, year])
  @@index([examId, year])
  @@index([collegeId])
}
